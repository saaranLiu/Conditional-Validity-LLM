# Copy to .env and fill in keys (never commit .env).

# HKUST-GZ AIGC (gpu1 可直连): https://aigc-api.hkust-gz.edu.cn/v1
# Models: Qwen, gpt-4-turbo, gpt-5.3-chat, DeepSeek-V4-Pro, DeepSeek-V4-Flash
HKUST_AIGC_API_KEY=your-hkust-key-here

# ChatAnywhere (gpu1 当前不可达，需代理): https://docs.chatanywhere.tech/
CHATANYWHERE_API_KEY=sk-your-key-here
